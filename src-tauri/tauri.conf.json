{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "videocut",
  "version": "0.2.1",
  "identifier": "com.videocut.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Videocut",
        "width": 1100,
        "height": 820,
        "minWidth": 900,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBRTAzOUUzQUQyMTZFMEEKUldRS2JpR3Q0em5ndXVTdlNobDZ1Ym8xRFBxVTB0bWliN1BucmlvK3hLd0kzK3Nua29IVkVNSkwK",
      "endpoints": [
        "https://github.com/MaximeBrusselle/videocut/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
